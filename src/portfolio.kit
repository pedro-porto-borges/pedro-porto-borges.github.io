<!DOCTYPE html>
<html lang="en">

<!--@import "_head.kit"-->

<body class="react-portfolio-page">
    <div class="react-page-shell">
        <!--@import "_header.kit"-->

        <main class="react-portfolio-main">
            <section class="react-portfolio-hero" aria-labelledby="portfolio-title">
                <div class="react-container">
                    <header class="react-portfolio-hero-panel">
                        <h1 id="portfolio-title">Portfolio</h1>
                        <div class="react-portfolio-hero-copy">
                            <p><strong>Selected projects, experiments, and case studies.</strong></p>
                            <p>A curated overview of selected projects, with each available case study linking to a
                                detailed page about the process, decisions, outcomes, and role.</p>
                        </div>
                    </header>
                </div>
            </section>

            <section id="case-studies" class="react-portfolio-cases" aria-label="Case studies">
                <div class="react-container">
                    <div class="react-portfolio-grid">
                        <a class="react-study-card" href="project-1.html" aria-label="Read the Itaú assisted sales channel case study">
                            <span class="react-study-image">
                                <img src="assets/images/projects/itau-mova/mova-hero@1x.jpg"
                                    srcset="assets/images/projects/itau-mova/mova-hero@1x.jpg 1x, assets/images/projects/itau-mova/mova-hero@2x.jpg 2x"
                                    width="969" height="606" alt="Ita&uacute; assisted sales channel project preview"
                                    loading="eager" decoding="async">
                            </span>
                            <span class="react-study-content">
                                <span class="react-study-meta">Professional / 2024</span>
                                <span class="react-study-title">Ita&uacute; - Assisted Sales Channel</span>
                                <span class="react-study-description">Simplifying a sensitive financial journey inside
                                    retail stores, balancing operational speed, customer clarity and compliance.</span>
                                <span class="react-study-link">Read case study <span
                                        aria-hidden="true">&rsaquo;</span></span>
                            </span>
                        </a>

                        <a class="react-study-card" href="project-2.html" aria-label="Read the Eventbrite Wallet case study">
                            <span class="react-study-image">
                                <img src="assets/images/projects/eventbrite/eventbrite-cover%20@1x.png" width="2880"
                                    height="1620" alt="Eventbrite Wallet project preview" loading="lazy"
                                    decoding="async">
                            </span>
                            <span class="react-study-content">
                                <span class="react-study-meta">Academic / 2025</span>
                                <span class="react-study-title">Eventbrite Wallet</span>
                                <span class="react-study-description">Reducing queues and unlocking new in-event revenue
                                    through a wallet-based purchase and redemption experience.</span>
                                <span class="react-study-link">Read case study <span
                                        aria-hidden="true">&rsaquo;</span></span>
                            </span>
                        </a>

                        <a class="react-study-card" href="project-3.html" aria-label="Read the Wise Young Explorer case study">
                            <span class="react-study-image">
                                <img src="assets/images/projects/wise/1.jpg" width="1920" height="1080"
                                    alt="Wise Young Explorer project preview" loading="lazy" decoding="async">
                            </span>
                            <span class="react-study-content">
                                <span class="react-study-meta">Academic / 2025</span>
                                <span class="react-study-title">Wise Young Explorer</span>
                                <span class="react-study-description">Helping young people gain financial independence
                                    while giving parents confidence, guidance and control.</span>
                                <span class="react-study-link">Read case study <span
                                        aria-hidden="true">&rsaquo;</span></span>
                            </span>
                        </a>

                        <article class="react-study-card react-study-card-disabled is-disabled" aria-disabled="true" aria-label="FBAUL website redesign case study unavailable">
                            <span class="react-study-image">
                                <img src="assets/images/projects/Fbaul/cover%20@1x.png"
                                    srcset="assets/images/projects/Fbaul/cover%20@1x.png 1x, assets/images/projects/Fbaul/cover%20@2x.png 2x"
                                    width="1920" height="1080" alt="Redesign Website FBAUL project preview"
                                    loading="lazy" decoding="async">

                            </span>
                            <span class="react-study-content">
                                <span class="react-study-meta">Academic / 2025</span>
                                <span class="react-study-title">Redesign - Website FBAUL</span>
                                <span class="react-study-description">Simplifying a sensitive financial journey inside
                                    retail stores, balancing operational speed, customer clarity and compliance.</span>
                                <span class="react-study-link">Case study unavailable</span>
                            </span>
                        </article>
                    </div>
                </div>
            </section>
        </main>

    <!--@import "_footer.kit"-->
    </div>
</body>

</html>
